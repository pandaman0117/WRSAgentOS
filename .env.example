# Runtime reads environment variables. This template is not auto-loaded.
# Loopback connect/nodes/wrs examples share generated local credentials by default.
# Optional override below: use the SAME value in each service/client run configuration.
# Leave empty for automatic example credentials; this is separate from GLM_API_KEY.
WRS_AGENT_TOKEN=

# GLM_API_KEY authenticates; GLM_BASE_URL selects the endpoint.
# GLM_MODEL is also required: set an actual model ID enabled on your account.
# No default model is assumed. In an IDE, load this file in each run configuration.
GLM_API_KEY=
GLM_MODEL=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# Optional: 1 uses HTTPX system/environment proxies and CA settings; 0 connects directly.
GLM_TRUST_ENV=0

# Coding Plan use must match the provider's authorized scope.
# models/01_plan.py and 02_execute.py call GLM online when run.
# The CLI still requires --live-model; neither path changes billing endpoints on failure.
# 01_plan only proposes; 02_execute runs the plan on the WRS virtual node.
